# ClientFlow API environment template
# Copy to .env.local for local development or to your deployment secret manager.
# Keep browser-only values out of this file.

# App / CORS
APP_URL=https://clientflow-2g9.pages.dev
CORS_ORIGIN=https://clientflow-2g9.pages.dev,https://clientflow-vjqd.onrender.com

# Database / auth
JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email / outbound integrations
EMAIL_SEND_ENABLED=false
RESEND_API_KEY=replace-with-your-resend-key
EMAIL_FROM_NAME=EA Management
EMAIL_FROM_ADDRESS=hello@example.com
EMAIL_REPLY_TO=support@example.com

# n8n / workflow automation
N8N_ENABLED=true
N8N_EMAIL_WEBHOOK_URL=https://your-n8n-instance.example/webhook/clientflow/send-form-email
CLIENTFLOW_N8N_SECRET=replace-with-a-random-shared-secret
N8N_EMAIL_BEARER_TOKEN="Bearer replace-with-a-random-bearer-token"
N8N_ORGANIZATION_ID=org_ea_management
N8N_TIMEOUT_MS=15000

# Storage (R2)
STORAGE_ENABLED=true
R2_ACCOUNT_ID=replace-with-your-r2-account-id
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
R2_BUCKET_NAME=eamanagement
R2_PUBLIC_URL=https://pub-<account-id>.r2.dev

# Security flags
ALLOW_UNAUTHENTICATED_CLIENT_CREATION=false
ALLOW_UNAUTHENTICATED_CONTRACT_MANAGEMENT=false
