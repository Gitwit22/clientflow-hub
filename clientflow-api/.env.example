# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4001
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Standalone ClientFlow database (never reuse API 2 DATABASE_URL)
DATABASE_URL=postgresql://user:password@localhost:5432/clientflow
ALLOW_UNAUTHENTICATED_CLIENT_CREATION=false

# ClientFlow-owned sessions
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 (disabled until configured)
STORAGE_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email (disabled until configured)
EMAIL_SEND_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM_NAME=EA Management
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=

# n8n lifecycle delivery (disabled until configured)
N8N_ENABLED=false
N8N_EMAIL_WEBHOOK_URL=
CLIENTFLOW_N8N_SECRET=
N8N_EMAIL_BEARER_TOKEN=
N8N_TIMEOUT_MS=15000
