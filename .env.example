# VITE_* values are embedded in browser assets and must never contain secrets.
# Use the live API by default; override locally when needed.
VITE_API_URL=https://nxt-lvl-api2.onrender.com

# For local development, set:
# VITE_API_URL=http://localhost:3000

# Server-only settings (database, JWT secrets, webhook secrets, R2 credentials)
# belong in clientflow-api/.env.local or your deployment secret store.