# Environment Configuration for ClientFlow Hub

# === APPLICATION ===
NODE_ENV=development
VITE_API_URL=http://localhost:3000/api

# === RENDER DEPLOYMENT ===
# Set these in your Render dashboard or via render.yaml

# === CLOUDFLARE WORKERS/PAGES DEPLOYMENT ===
VITE_CLOUDFLARE_ACCOUNT_ID=your-account-id-here
VITE_CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
VITE_CLOUDFLARE_ZONE_ID=your-zone-id-here

# === EMAIL SERVICE (SendGrid) ===
VITE_SENDGRID_API_KEY=SG.xxxxxxxxxxxxx
VITE_SENDGRID_FROM_EMAIL=noreply@clientflow.app

# === BACKEND API ===
VITE_BACKEND_URL=https://api.clientflow.app
VITE_BACKEND_API_KEY=your-backend-api-key-here

# === DATABASE (if using Prisma) ===
DATABASE_URL=postgresql://user:password@localhost:5432/clientflow

# === AUTHENTICATION (optional) ===
VITE_AUTH_PROVIDER=local
VITE_JWT_SECRET=your-jwt-secret-here

# === MONITORING & ANALYTICS ===
VITE_SENTRY_DSN=
VITE_ANALYTICS_ID=

# === SECURITY ===
VITE_CORS_ORIGIN=http://localhost:3000,https://clientflow.app
